GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=kthais
DB_SSLMODE=disable

# Server configuration
SERVER_PORT=8080
# Optional: bind address for the API listener. Leave unset in production/Docker
# (the container needs to bind all interfaces for the reverse proxy to reach
# it). For local dev on a machine with no NAT/router between it and the
# internet, set this to 127.0.0.1 to keep the dev server off the network.
# SERVER_HOST=127.0.0.1
BACKEND_URL="http://localhost:8080" # this is what OAuth uses to redirect back to

# Add a strong session key (generate with openssl rand -base64 32)
SESSION_KEY=<SESSION_KEY>

# JWT cookie: Secure flag (use true behind HTTPS in production)
SECURE_COOKIE=false

# Optional Domain for the JWT cookie. Leave unset for host-only cookies on the API host (typical local dev).
# For a shared parent domain in production use e.g. .kthais.com only if API and apps actually run on that domain.
# Never include a port (invalid); accidental host:port values are normalized to the host only.
# COOKIE_DOMAIN=

# Amazon SES
AWS_ACCESS_KEY_ID=<ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
AWS_REGION=eu-north-1
SES_SENDER=
SES_REPLY_TO=contact@kthais.com

# OAuth Configuration
OAUTH_STATE_TIMEOUT=600                         # State timeout in seconds
OAUTH_RATE_LIMIT_REQUESTS=5                     # Requests per minute
GOOGLE_PROMPT_TYPE=select_account consent       # Force consent screen

# Mailchimp configuration
MAILCHIMP_API_KEY=<MAILCHIMP_API_KEY>
MAILCHIMP_USER=<MAILCHIMP_USER>
MAILCHIMP_LIST_ID=<MAILCHIMP_LIST_ID>

# Luma configuration (newsletter signup registers members via Luma).
# All four are required together, or Luma is disabled entirely (like
# Mailchimp/SES above).
LUMA_API_KEY=<LUMA_API_KEY>
LUMA_MEMBERSHIP_TIER_ID=<LUMA_MEMBERSHIP_TIER_ID>
# Ids of "text" registration questions configured on the tier above, one for
# first name and one for last name. Luma's membership API has no name field
# of its own, so members show as "Anonymous" until fixed by hand in the Luma
# dashboard; these send the name as registration answers instead, visible on
# the member record for reference.
LUMA_FIRST_NAME_QUESTION_ID=<LUMA_FIRST_NAME_QUESTION_ID>
LUMA_LAST_NAME_QUESTION_ID=<LUMA_LAST_NAME_QUESTION_ID>

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem


JWTSigningKey=<PRIVATE_KEY>

JWTValidatingKey=<PUBLIC_KEY>

# JWTSigningKey=asdfasdf

# Shared secret with the landingpage-mcp service for POST /api/v1/auth/mcp-exchange.
# Generate with: openssl rand -base64 32
# Must be set identically on both services; never reuse another credential here.
MCP_SERVICE_SECRET=<MCP_SERVICE_SECRET>

# Shared secret with onboarding-service, used both ways: it checks this
# backend's outbound calls to onboarding-service's /notify, and this backend
# checks it on inbound calls to /internal/onboarding/*.
# Generate with: openssl rand -base64 32 — do not reuse MCP_SERVICE_SECRET.
ONBOARDING_SERVICE_SECRET=<ONBOARDING_SERVICE_SECRET>

# onboarding-service's base URL (no trailing slash). Leave empty locally
# until that service exists — the notify call is skipped, not fatal, when
# unset.
ONBOARDING_SERVICE_URL=

# R2 Credentials
R2_API_KEY=adfasdfasdf
R2_Access_Key_Id=asdfasdf
R2_Secret_Access_Key=asdfasdf
R2_Endpoint=asdfasdf
R2_Bucket=asdfasdf
R2_Account_Id=asdfasdf