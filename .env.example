# Local dev: run scripts/gen-dev-secrets.sh to create .env from this file and
# fill in the per-developer secrets (session key, JWT key pair, service
# secrets). Shared values like GOOGLE_CLIENT_ID/SECRET come from the team;
# locally, use the dev OAuth client's credentials, not prod's.
#
# Staging and production get these same names from kthaisociety/deployments,
# projects/landingpage-backend/project.yaml: plain values there, secrets from
# OpenBao (secret/landingpage-backend/<env>), shared ones from
# secret/shared/<env>, and DATABASE_URL / REDIS_* from the pipeline's own
# Postgres and Redis. Nothing below is copied there.

# --- Server ---
SERVER_PORT=8080
# Optional: bind address for the API listener. Leave unset in production/Docker
# (the container needs to bind all interfaces for the reverse proxy to reach
# it). For local dev on a machine with no NAT/router between it and the
# internet, set this to 127.0.0.1 to keep the dev server off the network.
# SERVER_HOST=127.0.0.1
# Enable dev-only behavior (seed data, DEV_ROLE_OVERRIDES). Set to true in
# your local .env; never in production.
DEVELOPMENT_MODE=false
# Public URL of this API; OAuth redirects back to BACKEND_URL/api/v1/auth/google/callback.
BACKEND_URL=http://localhost:8080
# Public URL of the frontend, used in links the backend sends (Team Questions).
FRONTEND_URL=http://localhost:3000
# CORS origins, comma-separated. The first one is the fallback after sign-in.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# DNS name of the reverse proxy whose X-Forwarded-For is trusted (Dokploy's Traefik).
TRUSTED_PROXY_HOST=dokploy-traefik

# --- Database (docker-compose.yml publishes Postgres on 127.0.0.1:5433) ---
# The pipeline sets DATABASE_URL (postgresql://user:pass@host:5432/db); when it
# is set it wins over DB_HOST..DB_NAME, and DB_SSLMODE is added if the URL has
# no sslmode. Locally, leave it unset and use the parts.
# DATABASE_URL=postgresql://postgres:password@localhost:5433/kthais
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=kthais
DB_SSLMODE=disable

# --- Redis (the pipeline sets all three) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Sessions and the member jwt cookie ---
# Add a strong session key (generate with openssl rand -base64 32)
SESSION_KEY=<SESSION_KEY>
# Secure flag on the jwt cookie (true behind HTTPS in staging/production).
# With SECURE_COOKIE=true and no COOKIE_DOMAIN the cookie is named __Host-jwt
# and stays on the host that set it; otherwise it's named jwt.
SECURE_COOKIE=false
# Domain for the jwt cookie. Leave unset: staging and production serve the API
# on the site's own host (/api/v1), and local dev shares localhost. Only for
# an API on a separate host; never include a port.
# COOKIE_DOMAIN=

# RS256 key pair for the member jwt cookie (PEM, real newlines or one line with
# literal \n). The backend refuses to start if either is missing, malformed, or
# they don't match. To generate a pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# The frontend needs the same public key as its JWT_PUBLIC_KEY (in the
# pipeline: the shared store, secret/shared/<env>).
JWT_PRIVATE_KEY=<PRIVATE_KEY>
JWT_PUBLIC_KEY=<PUBLIC_KEY>

# --- Google OAuth ---
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# Requests per minute per IP on the OAuth routes.
OAUTH_RATE_LIMIT_REQUESTS=5

# --- Local dev only ---
# Roles applied to these accounts on every Google sign-in, so you can see the
# app as admin/member/user. Change it, restart, and sign in again to switch.
# Format: email=role1,role2;email2=role. Valid roles: user, member, admin. The
# backend refuses to start if this is set without DEVELOPMENT_MODE=true. The
# roles are saved to your local database, so deleting your line keeps the last
# roles it set; change it to user,member (and sign in again) to drop admin
# instead.
# DEV_ROLE_OVERRIDES=you@kthais.com=user,member,admin

# --- Amazon SES (a <placeholder> key, or an empty SES_SENDER, disables email) ---
AWS_ACCESS_KEY_ID=<ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
SES_REGION=eu-north-1
SES_SENDER=
SES_REPLY_TO=contact@kthais.com

# --- Mailchimp (disabled when the key is empty) ---
MAILCHIMP_API_KEY=<MAILCHIMP_API_KEY>
MAILCHIMP_USER=kthais
MAILCHIMP_LIST_ID=<MAILCHIMP_LIST_ID>

# --- Luma ---
# Every member onboarding-service provisions is added to the "Members" tier
# automatically (POST /internal/onboarding/add-to-luma), and admins can
# retroactively add an existing member from the Members/Users admin panel.
# Both vars are required together, or Luma is disabled entirely (like
# Mailchimp/SES above).
LUMA_API_KEY=<LUMA_API_KEY>
# Look this id up with:
#   curl -H "x-luma-api-key: $LUMA_API_KEY" \
#     https://public-api.luma.com/v1/memberships/tiers/list
LUMA_MEMBERS_TIER_ID=<LUMA_MEMBERS_TIER_ID>

# --- Service-to-service ---
# Shared secret with the landingpage-mcp service for POST /api/v1/auth/mcp-exchange.
# Generate with: openssl rand -base64 32
# Must be set identically on both services; never reuse another credential here.
MCP_SERVICE_SECRET=<MCP_SERVICE_SECRET>

# Shared secret with onboarding-service, used both ways: it checks this
# backend's outbound calls to onboarding-service's /notify, and this backend
# checks it on inbound calls to /internal/onboarding/*. In the pipeline it is
# in the shared store, which onboarding-service reads too.
# Generate with: openssl rand -base64 32 — do not reuse MCP_SERVICE_SECRET.
ONBOARDING_SERVICE_SECRET=<ONBOARDING_SERVICE_SECRET>

# onboarding-service's base URL (no trailing slash). Leave empty locally
# until that service exists — the notify call is skipped, not fatal, when
# unset. In the pipeline: http://onboarding-service-<env>-<suffix>:8000.
ONBOARDING_SERVICE_URL=

# --- Cloudflare R2 (until object storage moves to GleSYS, IT-39) ---
R2_Access_Key_Id=<R2_ACCESS_KEY_ID>
R2_Secret_Access_Key=<R2_SECRET_ACCESS_KEY>
R2_Endpoint=<R2_ENDPOINT>
R2_Bucket=<R2_BUCKET>
